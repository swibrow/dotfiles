#!/bin/bash
set -euo pipefail

# mise config hash: {{ include "mise/config.toml" | sha256sum }}
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"

if ! command -v mise &>/dev/null; then
    echo "[INFO] Installing mise..."
    curl -fsSL https://mise.run | sh
fi

# Anonymous GitHub API calls are limited to 60/hour, far fewer than the tools listed
if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh &>/dev/null; then
    GITHUB_TOKEN="$(gh auth token 2>/dev/null || true)"
    export GITHUB_TOKEN
fi

echo "[INFO] Installing mise tools..."
mise install --yes
