[toplevel]

# Pickers (need fzf). Each prints its selection so it can be captured:
#   export AWS_PROFILE=$(aws profile-pick)
#   EKS_ROLE_ARN=$(aws role-pick eks) aws eks-update
profile-list = !f() { awk '/^\[/{ if (n) print n, a, r; n=$0; gsub(/^\[(profile )?|\]$/, "", n); a="-"; r="-" } /sso_account_id/{ a=$0; sub(/.*=[ \t]*/, "", a) } /sso_role_name/{ r=$0; sub(/.*=[ \t]*/, "", r) } END{ if (n) print n, a, r }' ~/.aws/config | sort | column -t; }; f
profile-pick = !f() { aws profile-list | fzf --height=15 --border --prompt="profile> " --query "${1:-}" | awk '{print $1}'; }; f
role-pick = !f() { aws iam list-roles --query 'Roles[].Arn' --output text | tr '\t' '\n' | sort | fzf --height=15 --border --prompt="role> " --query "${1:-}"; }; f
cluster-pick = !f() { region="${1:-}"; set --; [ -n "$region" ] && set -- --region "$region"; aws eks list-clusters "$@" --query 'clusters[]' --output text | tr '\t' '\n' | sort | fzf --height=15 --border --prompt="cluster> "; }; f

# Pick an EKS cluster and update kubeconfig (context alias = cluster name).
#   aws eks-update                       # region/profile from the environment
#   aws eks-update eu-west-1
#   EKS_ROLE_ARN=... aws eks-update      # cross-account: kubectl assumes that role
eks-update = !f() { region="${1:-}"; cluster=$(aws cluster-pick "$region") || return 1; [ -n "$cluster" ] || return 1; set --; [ -n "$region" ] && set -- --region "$region"; [ -n "${EKS_ROLE_ARN:-}" ] && set -- "$@" --role-arn "$EKS_ROLE_ARN"; aws eks update-kubeconfig --name "$cluster" --alias "$cluster" "$@"; }; f
eks-list = !f() { region="${1:-}"; set --; [ -n "$region" ] && set -- --region "$region"; aws eks list-clusters "$@" --query 'clusters[]' --output text | tr '\t' '\n'; }; f

whoami = sts get-caller-identity
identity = !f() { aws sts get-caller-identity --query '[Account,Arn,UserId]' --output table; }; f

