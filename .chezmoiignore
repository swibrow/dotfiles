.pre-commit-config.yaml

# The Brewfiles themselves are not deployed - .config/homebrew/ holds symlinks
# back into the source dir, so `brew bundle dump/add/remove` writes into the repo.
homebrew/**

# Likewise for the mise global config - .config/mise/config.toml is a symlink
# back into the source dir so hand-edits and `mise` writes land in the repo.
mise/**

# Same again for the global justfile and its modules - ~/.justfile and
# ~/.config/just are symlinks into just/ so edits land in the repo.
just/**

# Zed rewrites settings.json from its UI - ~/.config/zed/settings.json is a
# symlink into zed/ so those writes land in the repo.
zed/**

# Docs & CI
docs/**
mkdocs.yml
.github/**
site/**
.venv/**

# Binary / runtime data
.config/how/memory.db

# macOS-only (profile != osx)
{{ if ne .profile "osx" }}
.config/aerospace/**
.config/ghostty/**
.config/homebrew/Brewfile.macos
.config/sesh/**
.config/karabiner/**
.finicky.js
Library/LaunchAgents/**
.local/bin/keychain-secret
.local/bin/keyfreq.swift
{{ end }}

# never publish the mise age identity (cluster private key)
.config/mise/age.txt
