#!/usr/bin/env bash
# Age-encrypt a secret into the private mise config. Reads the value hidden from the tty, or from stdin.

set -euo pipefail
name="${1:?usage: mise-secret-set NAME}"
if [ -t 0 ]; then
  printf "Enter value for '%s': " "$name" >&2
  stty -echo; IFS= read -r value || true; stty echo; echo >&2
else
  IFS= read -r value || true
fi
[ -n "$value" ] || { echo "error: empty value" >&2; exit 1; }
src="$HOME/.config/dotfiles-private/mise.toml"
recipients="$HOME/.config/dotfiles-private/age-recipients.txt"
args=()
if [ -f "$recipients" ]; then
  # Explicit recipients replace mise's defaults, so refuse a list that would
  # lock this machine out of what it writes.
  if [ -f "$HOME/.config/mise/age.txt" ] && command -v age-keygen >/dev/null; then
    own=$(age-keygen -y "$HOME/.config/mise/age.txt")
    grep -qF "$own" "$recipients" || { echo "error: this machine's age key $own is not in $recipients" >&2; exit 1; }
  fi
  while read -r key rest; do
    case "$key" in
      age1*) args+=(--age-recipient "$key") ;;
      ssh-*) args+=(--age-ssh-recipient "$key $rest") ;;
    esac
  done < "$recipients"
fi
mise trust --quiet "$src" 2>/dev/null || true
mise set --age-encrypt ${args[@]+"${args[@]}"} --file "$src" "$name=$value"
echo "Stored '$name' age-encrypted in $src (commit it in that repo)" >&2
