#!/usr/bin/env bash
# Re-encrypt every secret in the private mise config to the keys in age-recipients.txt. Run after adding or removing a machine.

set -euo pipefail
src="$HOME/.config/dotfiles-private/mise.toml"
# From $HOME so no project config shadows the private values.
env_json=$(cd "$HOME" && mise env --json)
for name in $(sed -nE 's/^([A-Z0-9_]+)[[:space:]]*=[[:space:]]*\{[[:space:]]*age[[:space:]]*=.*/\1/p' "$src"); do
  jq -er --arg n "$name" '.[$n]' <<<"$env_json" | mise-secret-set "$name"
done
