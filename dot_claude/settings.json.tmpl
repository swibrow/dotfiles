{
  "cleanupPeriodDays": 999999,
  "env": {},
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(chezmoi diff:*)",
      "Bash(chezmoi status:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.pem)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Read(~/.config/mise/age.txt)"
    ],
    "ask": []
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase",
    "github"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/dev/swibrow/hops/bin/hops update --auto"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "claude-code-tracing@coding-harness-tracing": true
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "coding-harness-tracing": {
      "source": {
        "source": "github",
        "repo": "Arize-ai/coding-harness-tracing"
      }
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "editorMode": "vim",
  "effortLevel": "high",
  "autoUpdatesChannel": "stable",
  "showTipsOnStartup": false,
  "spinnerTipsEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
