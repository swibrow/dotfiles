# macOS-only: GUI casks + the handful of `brew` formulas that only work on
# macOS. Installed only when .profile == "osx" — see
# .chezmoiscripts/run_onchange_before_02-install-brewfile.sh.tmpl

tap "barutsrb/tap", "https://github.com/BarutSRB/homebrew-tap", trusted: true
tap "nikitabobko/tap", trusted: true
tap "oktadev/tap", "https://github.com/oktadev/homebrew-tap.git", trusted: true
tap "postfinance/tap"
tap "warrensbox/tap", trusted: true

# Dependency manager for Cocoa projects
brew "cocoapods"
# Install and debug iPhone apps from the command-line
brew "ios-deploy"
# Pinentry for GPG on Mac
brew "pinentry-mac"
# Send macOS User Notifications from the command-line
brew "terminal-notifier"

# AeroSpace is an i3-like tiling window manager for macOS
cask "nikitabobko/tap/aerospace", trusted: true
# Automatic tiling window manager similar to xmonad
cask "amethyst"
# Kubernetes desktop client
cask "aptakube"
# Tool to flash OS images to SD cards & USB drives
cask "balenaetcher"
# Open source IDE for exploring and testing APIs
cask "bruno"
# OpenAI's coding agent that runs in your terminal
cask "codex"
cask "container"
# Launch builds and start simulators from your menu bar
cask "expo-orbit"
# Utility for customizing which browser to start
cask "finicky"
cask "font-hack-nerd-font"
cask "font-meslo-lg-nerd-font"
# Set of tools to manage resources and applications hosted on Google Cloud
cask "gcloud-cli"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Free and open-source image editor
cask "gimp"
# UI for Kubernetes
cask "headlamp"
# Keyboard customiser
cask "karabiner-elements"
# Open-source keystroke visualiser
cask "keycastr"
# Interactive tool for analyzing MongoDB data
cask "mongodb-compass"
# GameStream client
cask "moonlight"
# Visual tool to design, develop and administer MySQL servers
cask "mysqlworkbench"
# Reverse proxy, secure introspectable tunnels to localhost
cask "ngrok"
# Open-source software for live streaming and screen recording
cask "obs"
cask "oktadev/tap/okta"
# Tiling window manager for macOS with Niri-inspired column-based layout
cask "barutsrb/tap/omniwm", trusted: true
# Whisper dictation/transcription app
cask "opensuperwhisper"
# Utility to uninstall apps and remove leftover files from old/uninstalled apps
cask "pearcleaner"
# Control your tools with a few keystrokes
cask "raycast"
# Mesh VPN based on WireGuard
cask "tailscale-app"
# The tfswitch command lets you switch between terraform versions.
cask "warrensbox/tap/tfswitch", trusted: true
# Talos Orchestrator by PostFinance
cask "postfinance/tap/topf", trusted: true
# Binary releases of VS Code without MS branding/telemetry/licensing
cask "vscodium"
# GPU-accelerated cross-platform terminal emulator and multiplexer
cask "wezterm"
# Network monitoring and troubleshooting tool
cask "wifiman"
# Multiplayer code editor
cask "zed"
